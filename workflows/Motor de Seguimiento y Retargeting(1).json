    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    i.id, \n    i.telefono, \n    c.nombre, \n    p.nombre AS producto_nombre, \n    p.categoria, \n    i.tipo_evento, \n    i.fecha,\n    CASE \n        WHEN i.tipo_evento = 'CONSULTA' THEN 'CARRITO'\n        WHEN i.tipo_evento = 'COMPRA' AND i.fecha <= NOW() - INTERVAL '15 days' THEN 'CROSS_SELLING'\n        WHEN i.tipo_evento = 'COMPRA' AND i.fecha <= NOW() - INTERVAL '7 days' THEN 'CALIDAD'\n    END AS destino_flujo\nFROM interacciones i \nJOIN productos p ON i.producto_id = p.id \nJOIN clientes c ON i.telefono = c.telefono \nWHERE i.seguimiento_completado = false \n  AND (c.ultimo_mensaje_bot IS NULL OR c.ultimo_mensaje_bot <= NOW() - INTERVAL '7 days') \n  AND c.ultima_interaccion_cliente <= NOW() - INTERVAL '24 hours'\n  AND (\n      (i.tipo_evento = 'CONSULTA' AND i.fecha <= NOW() - INTERVAL '1 day')\n      OR (i.tipo_evento = 'COMPRA' AND i.fecha <= NOW() - INTERVAL '7 days') \n  )",
        "options": {}
      },
      "id": "7fae8540-a723-470a-b3f8-3989e079ab31",
      "name": "Buscar Interacciones (Unificado)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -1696,
        208
      ],
      "credentials": {
        "postgres": {
          "id": "XAlxZzVnXRA3vMZo",
          "name": "Postgres Docker"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const validItems = [];\nconst invalidItems = [];\n\nconst items = $input.all();\n\nfor (const item of items) {\n  const data = item.json;\n  \n  const hasId = data.id !== undefined && data.id !== null;\n  const hasPhone = typeof data.telefono === 'string' && data.telefono.trim().length > 6;\n  const hasClientName = typeof data.nombre === 'string';\n  const hasDestino = typeof data.destino_flujo === 'string';\n  \n  if (hasId && hasPhone && hasClientName && hasDestino) {\n    validItems.push(item);\n  } else {\n    invalidItems.push({\n      json: {\n        error: \"Payload inválido o campos faltantes\",\n        timestamp: new Date().toISOString(),\n        originalData: data\n      }\n    });\n  }\n}\n\nreturn [validItems, invalidItems];"
      },
