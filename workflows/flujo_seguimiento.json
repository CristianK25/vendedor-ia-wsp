{
  "name": "Motor de Seguimiento y Retargeting",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 11 * * *"
            }
          ]
        }
      },
      "id": "cron-unificado",
      "name": "Cron (11:00) - Unificado",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        448
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    i.id, \n    i.telefono, \n    c.nombre, \n    p.nombre AS producto_nombre, \n    p.categoria, \n    i.tipo_evento, \n    i.fecha,\n    CASE \n        WHEN i.tipo_evento = 'CONSULTA' THEN 'CARRITO'\n        WHEN i.tipo_evento = 'COMPRA' AND i.fecha <= NOW() - INTERVAL '15 days' THEN 'CROSS_SELLING'\n        WHEN i.tipo_evento = 'COMPRA' AND i.fecha <= NOW() - INTERVAL '7 days' THEN 'CALIDAD'\n    END AS destino_flujo\nFROM interacciones i \nJOIN productos p ON i.producto_id = p.id \nJOIN clientes c ON i.telefono = c.telefono \nWHERE i.seguimiento_completado = false \n  AND (c.ultimo_mensaje_bot IS NULL OR c.ultimo_mensaje_bot <= NOW() - INTERVAL '7 days') \n  AND c.ultima_interaccion_cliente <= NOW() - INTERVAL '24 hours'\n  AND (\n      (i.tipo_evento = 'CONSULTA' AND i.fecha <= NOW() - INTERVAL '1 day')\n      OR (i.tipo_evento = 'COMPRA' AND i.fecha <= NOW() - INTERVAL '7 days') \n  )"
      },
      "id": "sql-unificado",
      "name": "Buscar Interacciones (Unificado)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        200,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "const validItems = [];\nconst invalidItems = [];\n\nconst items = $input.all();\n\nfor (const item of items) {\n  const data = item.json;\n  \n  const hasId = data.id !== undefined && data.id !== null;\n  const hasPhone = typeof data.telefono === 'string' && data.telefono.trim().length > 6;\n  const hasClientName = typeof data.nombre === 'string';\n  const hasDestino = typeof data.destino_flujo === 'string';\n  \n  if (hasId && hasPhone && hasClientName && hasDestino) {\n    validItems.push(item);\n  } else {\n    invalidItems.push({\n      json: {\n        error: \"Payload inválido o campos faltantes\",\n        timestamp: new Date().toISOString(),\n        originalData: data\n      }\n    });\n  }\n}\n\nreturn [validItems, invalidItems];"
      },
      "id": "code-validate",
      "name": "Validar Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        448
      ],
      "typeOptions": {
        "multipleValues": {
          "main": 2
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "loop-node",
      "name": "Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        600,
        448
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.destino_flujo }}",
        "rules": {
          "rules": [
            {
              "value2": "CARRITO",
              "output": 0
            },
            {
              "value2": "CALIDAD",
              "output": 1
            },
            {
              "value2": "CROSS_SELLING",
              "output": 2
            }
          ]
        },
        "fallbackOutput": "none"
      },
      "id": "switch-node",
      "name": "Switch: Tipo Evento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        800,
        448
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Redacta un mensaje amable por WhatsApp para {{ $json.nombre }}, quien hace 24 horas consultó por {{ $json.producto_nombre }} pero no finalizó la compra.",
        "options": {
          "systemMessage": "Eres un experto en ventas. Tu objetivo es recuperar carritos abandonados. Sé sutil, no presiones, y ofrece ayuda o alternativas. Mantén el mensaje corto."
        }
      },
      "id": "ai-carrito",
      "name": "IA Redactor (Carrito)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Redacta un mensaje para {{ $json.nombre }}, quien compró {{ $json.producto_nombre }} hace 3 días. Pregúntale si todo llegó bien y qué le pareció.",
        "options": {
          "systemMessage": "Eres un asistente de atención al cliente. Tu objetivo es fidelizar y asegurar que la compra fue exitosa. Sé cálido y muy breve."
        }
      },
      "id": "ai-calidad",
      "name": "IA Redactor (Calidad)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        1100,
