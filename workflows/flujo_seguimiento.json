      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Redacta un mensaje para {{ $json.nombre }}, quien compró {{ $json.producto_nombre }} (Categoría: {{ $json.categoria }}) hace 15 días. Ofrécele sutilmente volver a comprar o ver productos relacionados de la misma categoría.",
        "options": {
          "systemMessage": "Eres un vendedor experto en retargeting. Tu objetivo es generar una recompra o cross-selling sin parecer spam. Escribe como si fueras un humano acordándose de él."
        }
      },
