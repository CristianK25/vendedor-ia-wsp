{
  "name": "Motor de Seguimiento y Retargeting",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 11 * * *"
            }
          ]
        }
      },
      "id": "cron-carrito",
      "name": "Cron (11:00) - Carrito",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT i.id, i.telefono, c.nombre, p.nombre AS producto_nombre FROM interacciones i JOIN productos p ON i.producto_id = p.id JOIN clientes c ON i.telefono = c.telefono WHERE i.tipo_evento = 'CONSULTA' AND i.fecha <= NOW() - INTERVAL '1 day' AND i.seguimiento_completado = false AND (c.ultimo_mensaje_bot IS NULL OR c.ultimo_mensaje_bot <= NOW() - INTERVAL '7 days') AND c.ultima_interaccion_cliente <= NOW() - INTERVAL '24 hours'"
      },
      "id": "sql-carrito",
      "name": "Buscar Carritos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Redacta un mensaje amable por WhatsApp para {{ $json.nombre }}, quien hace 24 horas consultó por {{ $json.producto_nombre }} pero no finalizó la compra.",
        "options": {
          "systemMessage": "Eres un experto en ventas. Tu objetivo es recuperar carritos abandonados. Sé sutil, no presiones, y ofrece ayuda o alternativas. Mantén el mensaje corto."
        }
      },
      "id": "ai-carrito",
      "name": "IA Redactor (Carrito)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Buscar Carritos').item.json.telefono }}",
        "text": "={{ $json.output }}",
        "additionalFields": {}
      },
      "id": "telegram-carrito",
      "name": "Telegram (Carrito)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "sNEgRxsnCouQBM1B",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE interacciones SET seguimiento_completado = true WHERE id = {{ $('Buscar Carritos').item.json.id }}; UPDATE clientes SET ultimo_mensaje_bot = CURRENT_TIMESTAMP WHERE telefono = '{{ $('Buscar Carritos').item.json.telefono }}';"
      },
      "id": "update-carrito",
      "name": "Actualizar DB (Carrito)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        912,
