    {
      "parameters": {
        "jsCode": "// Obtenemos el chat_id del nodo Trigger usando .first()\nconst chat_id = $('Telegram Trigger').first().json.message.chat.id;\n\n// Obtenemos el JSON del nodo \"Extraer todos los mensajes\"\nconst mensajesJson = $('Extraer todos los mensajes').first().json;\n\n// Extraemos solo los nombres de las propiedades (las claves de Redis de los mensajes)\nlet claves_a_borrar = Object.keys(mensajesJson);\n\n// Sumamos también la clave del contador \"esperando\" para reiniciar la ráfaga\nclaves_a_borrar.push(`esperando:${chat_id}`);\n\n// Convertimos esa lista en \"Items\" de n8n para pasárselos al nodo siguiente\nreturn claves_a_borrar.map(clave => ({ json: { clave_a_borrar: clave } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        0
      ],
      "id": "491b3ed7-420c-4120-a34c-b5833dfd17ae",
      "name": "Extraer Mensajes Redis"
