# Zona horaria del servidor
GENERIC_TIMEZONE=America/Argentina/Mendoza

# Clave de encriptación de n8n (Genera una contraseña segura y aleatoria para cada cliente)
# IMPORTANTE: Si pierdes esta clave, no podrás desencriptar las credenciales guardadas en n8n.
N8N_ENCRYPTION_KEY=reemplazar_por_una_clave_muy_segura

# Base de datos PostgreSQL para el negocio
POSTGRES_USER=n8n
POSTGRES_PASSWORD=reemplazar_por_password_seguro
POSTGRES_DB=vendedor_ia

# Proveedores de IA para el Agente en el Backend
# Orden de prioridad separado por comas (se usan solo los que tengan API Key configurada)
# Configuración por defecto: 100% Gratuito vía Groq (y OpenRouter como respaldo gratuito opcional)
LLM_PROVIDER_ORDER=groq,openrouter,gemini,openai,anthropic

# 1. GROQ (100% Gratis sin tarjeta - https://console.groq.com)
# Modelos sugeridos: llama-3.3-70b-versatile (alta calidad) o llama-3.1-8b-instant (14.400 req/día)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OPENROUTER (Opcional - Modelos :free como respaldo - https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# 3. Proveedores de Pago / Cuenta del Cliente (dejar vacíos si el cliente aún no los entregó)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

TELEGRAM_BOT_TOKEN=tu_token_aqui

# API Key para conexión interna segura (M2M) entre n8n y Backend
N8N_API_KEY=
DB_ECHO=false

# Clave secreta para firmar tokens JWT en el Backend (¡Muy importante en producción!)
SECRET_KEY=reemplazar_por_una_clave_muy_segura

# URL pública de n8n para el webhook en producción (ej. https://n8n.tudominio.com)
N8N_WEBHOOK_URL=

# Orígenes CORS permitidos para el Backend (separados por coma, ej. https://crm.tudominio.com)
# Por defecto se permite "*" si se deja vacío.
BACKEND_CORS_ORIGINS=

# Usuario administrador por defecto y contraseña (se crearán en el primer arranque)
INITIAL_ADMIN_EMAIL=admin@vendedor.com
INITIAL_ADMIN_PASSWORD=admin123

# Credenciales de conexión interna para el bot de n8n
INITIAL_BOT_EMAIL=bot@vendedor.com
INITIAL_BOT_PASSWORD=bot1234
